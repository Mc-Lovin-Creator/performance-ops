# Copy to backend/.env (never commit the real file).
MONGO_URL=mongodb://localhost:27017
DB_NAME=performance_lab
# Generate both with:  python -m core.admin gen-key
JWT_SECRET=
FIELD_KEY=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
REQUIRE_2FA_P1=1
# One-time key to create the first lead account (stage 2). Remove it once the account exists.
SETUP_TOKEN=

# ---- Wearables (docs/WEARABLES.md). Leave a provider blank to hide it.
# Public URLs: the API (for OAuth redirects and ingest) and the app (link back after connecting)
PUBLIC_API_URL=
APP_URL=
# Register an app with each provider; the redirect URL is  <PUBLIC_API_URL>/api/wear/<provider>/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Garmin push URL:  <PUBLIC_API_URL>/api/wear/garmin/push?k=<GARMIN_PUSH_KEY>   (24+ random characters)
GARMIN_PUSH_KEY=
# Daily scheduled sync: POST <PUBLIC_API_URL>/api/wear/sync-all with header x-cron-key (32+ random characters)
WEAR_CRON_KEY=

# Innovation scout (optional, public sources only; see deploy/stages/4b-scout.md)
# Grok on the web and X. Off when empty. Get a key at console.x.ai; type it into Emergent yourself.
XAI_API_KEY=
XAI_MODEL=grok-4.7
# X accounts to watch for launches and drops (no @, comma separated, up to 20)
SCOUT_X_HANDLES=
# Feeds, one per ';': lane|source name|https://feed-url   (YouTube channel: https://www.youtube.com/feeds/videos.xml?channel_id=<id>)
# Lanes: Performance science, Wearables and hardware, Software and AI, Apparel and footwear, Nutrition and supplements, Padel, Longevity, Recovery and rehab, Launches and drops
SCOUT_FEEDS=
# Daily run: POST <PUBLIC_API_URL>/api/scout/run with header x-cron-key (32+ random characters)
SCOUT_CRON_KEY=
